        self.assertEqual(reverse_words(\"one two three\"), \"three two one\")\n\n    def test_slugify(self):\n        self.assertEqual(slugify(\"Hello World\"), \"hello-world\")\n        self.assertEqual(slugify(\"Hello  World\"), \"hello-world\")\n        self.assertEqual(slugify(\"hello-world\"), \"hello-world\")\n        self.assertEqual(slugify(\"Hello_World\"), \"hello-world\")\n        self.assertEqual(slugify(\"hello@world#test\"), \"hello-world-test\")\n        self.assertEqual(slugify(\"---hello---\"), \"hello\")\n        self.assertEqual(slugify(\"hello\"), \"hello\")\n        self.assertEqual(slugify(\"123ABC\"), \"123abc\")\n        self.assertEqual(slugify(\"\"), \"\")\n        self.assertEqual(slugify(\"!!!\"), \"\")\n        self.assertEqual(slugify(\"  hello  world  \"), \"hello-world\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":30,"startLine":1,"totalLines":30}},"sourceToolAssistantUUID":"c6c66e37-8f59-4a06-9e0f-37dfdcd961b2","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-cli","cwd":"/work/happy-path","sessionId":"ac884d53-1d6d-4a3e-b4e1-a07a055dc4ec","version":"2.1.322","gitBranch":"main"}
