f):\n        self.assertEqual(reverse_words(\"one two three\"), \"three two one\")\n\n    def test_slugify(self):\n        self.assertEqual(slugify(\"Hello World\"), \"hello-world\")\n        self.assertEqual(slugify(\"Hello  World\"), \"hello-world\")\n        self.assertEqual(slugify(\"hello world\"), \"hello-world\")\n        self.assertEqual(slugify(\"Hello_World\"), \"hello-world\")\n        self.assertEqual(slugify(\"Hello-World\"), \"hello-world\")\n        self.assertEqual(slugify(\"-Hello World-\"), \"hello-world\")\n        self.assertEqual(slugify(\"Hello!!!World\"), \"hello-world\")\n        self.assertEqual(slugify(\"123 ABC xyz\"), \"123-abc-xyz\")\n        self.assertEqual(slugify(\"\"), \"\")\n        self.assertEqual(slugify(\"---\"), \"\")\n        self.assertEqual(slugify(\"   \"), \"\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":30,"startLine":1,"totalLines":30}},"sourceToolAssistantUUID":"0685dd61-3a65-4e66-abd0-9943e32930bd","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"sdk-cli","cwd":"/work/controller-killed","sessionId":"8714e88b-f8d9-403d-b218-0299491330f4","version":"2.1.322","gitBranch":"main"}
